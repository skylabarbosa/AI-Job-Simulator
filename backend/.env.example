APP_NAME=AI Job Simulator Backend
APP_ENV=development
# Comma-separated explicit frontend origins. Required in production; do not use
# trailing slashes or '*' (example: https://your-app.vercel.app,https://another-approved-origin.com).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATASET_MAX_FILE_SIZE_BYTES=10485760
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_REQUESTS_PER_MINUTE=20
